{
	admin off
	auto_https off
}
:8091 {
	# One handle per person, each serving a page made from site/as-user.html.template.
	handle /as/alex {
		rewrite * /alex.html
		root * /srv
		file_server
	}
	handle /pick {
		rewrite * /pick.html
		root * /srv
		file_server
	}
	@nouser {
		not header Cookie *board_user=*
		not path /pick /as/* /api/* /users/* /sockjs/* /websocket* /packages/* /*.js /*.css /*.map /*.png /*.svg /*.ico /*.woff* /fonts/* /cdn/* /__meteor__/* /_timesync
	}
	header @nouser Set-Cookie "board_next={path}; Path=/; Max-Age=600; SameSite=Lax"
	redir @nouser /pick 302
	@api {
		path /api/*
		not header Authorization *
	}
	request_header @api Authorization "Bearer {$AGENTS_TOKEN}"
	reverse_proxy 127.0.0.1:8080
}
